# matplotlib settings for the manuscript displays (used by manuscript/build_displays.py via MATPLOTLIBRC).
# DejaVu Sans ships with matplotlib, so the figures need no system font; with the same matplotlib version (3.11.2 for
# the committed figures) the PDFs are byte-identical across machines. Fonts are embedded as TrueType (Type 42), not
# Type 3, which many submission systems reject.
font.family: DejaVu Sans
text.hinting: no_hinting
pdf.fonttype: 42
